# 이 파일을 저장소 루트에 `.env` 로 복사해서 값을 채운다.
# `src/env.py` 가 읽어서 환경변수로 올린다.
# 시스템 환경변수가 항상 우선이고, 빈 값은 무시된다.
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# `.env` 는 .gitignore 에 있다. 절대 커밋하지 말 것.

# ── Threads 앱 (threads_auth.py 로 토큰 발급할 때만 쓴다) ──────────
# Meta 개발자 콘솔 https://developers.facebook.com 에서 앱을 만들고
# 'Threads API' 제품을 추가한 뒤 얻는다.
# 리디렉션 URI 는 콘솔에 등록한 값과 한 글자도 다르면 안 된다.
# 로컬 서버를 띄우지 않고 주소창의 URL 만 복사해 쓰므로
# 실제로 열리지 않는 주소여도 된다.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost/

# ── Threads 토큰 ──────────────────────────────────────────────────
# 보통은 비워 둔다. threads_auth.py 가 src/token.json 에 저장하고
# threads_post.py 가 그걸 우선 읽는다.
# 토큰을 손으로 관리하고 싶을 때만 채운다.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── 실패 알림 (무인 운영이면 사실상 필수) ─────────────────────────
# 이게 없으면 run_all.py 가 실패해도 아무에게도 안 알린다.
# 무인 운영에서 최악은 조용히 멈추는 것이다.
# 텔레그램에서 @BotFather 로 봇을 만들고 토큰을 받는다.
# TG_CHAT_ID 는 봇에게 아무 말이나 건 뒤
# https://api.telegram.org/bot<토큰>/getUpdates 에서 확인한다.
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── 카톡 채팅방 이름 일부 ─────────────────────────────────────────
# 이모지는 넣지 말 것. 콘솔 인코딩 문제가 생긴다(T1 관측).
KAKAO_ROOM=쿠팡 실시간 핫딜방
