# 이 파일을 저장소 루트에 `.env` 로 복사해서 값을 채운다.
# `src/env.py` 가 읽어서 환경변수로 올린다.
# 시스템 환경변수가 항상 우선이고, 빈 값은 무시된다.
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# `.env` 는 .gitignore 에 있다. 절대 커밋하지 말 것.

# ── Threads 앱 (threads_auth.py 로 토큰 발급할 때만 쓴다) ──────────
# Meta 개발자 콘솔 https://developers.facebook.com 에서 앱을 만들고
# 'Threads API' 제품을 추가한 뒤 얻는다.
# 리디렉션 URI 는 콘솔에 등록한 값과 한 글자도 다르면 안 된다.
# 로컬 서버를 띄우지 않고 주소창의 URL 만 복사해 쓰므로
# 실제로 열리지 않는 주소여도 된다.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost/

# ── Threads 토큰 ──────────────────────────────────────────────────
# 보통은 비워 둔다. threads_auth.py 가 src/token.json 에 저장하고
# threads_post.py 가 그걸 우선 읽는다.
# 토큰을 손으로 관리하고 싶을 때만 채운다.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── 텔레그램 (필수) ───────────────────────────────────────────────
# 만들어진 문구를 보내는 통로이자 실패 알림 통로다.
# 이게 없으면 파이프라인이 아무것도 내보내지 못하고, 실패해도 안 알린다.
# 텔레그램에서 @BotFather 로 봇을 만들고 토큰을 받는다.
TG_BOT_TOKEN=

# 소유자 본인의 chat_id. 세 가지 뜻이 있다.
#   1. 실패 알림을 받는 곳
#   2. /start 를 안 눌렀어도 딜을 받는다
#   3. **관리자** — 지금은 구독자 목록 조회(/subs)만 관리자 전용이다
#
# 변환은 /start 한 사람이면 누구나 시킬 수 있다(2026-08-03 소유자 지시).
#
# 알아내는 법: 봇에게 아무 말이나 한 번 건 뒤
#   py src/telegram_deliver.py --whoami
TG_CHAT_ID=

# 관리자를 더 두려면 쉼표로 나열한다. 보통은 비워 둔다.
# 관리자만 할 수 있는 것은 이제 구독자 목록 조회(/subs) 뿐이다.
TG_ADMIN_IDS=

# ── 변환 속도 — 기본은 제한 없음 ──────────────────────────────────
# 변환은 /start 한 사람 누구나, 보내는 대로 바로 처리한다.
# (2026-08-03 소유자 지시. 사용자가 최대 2명이라 총량 제한을 껐다)
#
# 사람이 늘면 아래를 켠다. 0 은 '제한 없음' 이다.
# CONVERT_PER_HOUR=0         전체 합계(관리자 포함)
# CONVERT_PER_HOUR_EACH=0    1인당
# CONVERT_MIN_GAP=0          연타 방지(초)

# ── 새 구독자에게 지난 딜을 몇 건까지 줄 것인가 ───────────────────
# 0 이면 가입 후 올라온 것만. 그러면 가입 직후 아무것도 안 와서
# 고장난 것처럼 보인다. 제한이 없으면 첫인사가 수십 통 스팸이 된다.
# WELCOME_CATCHUP=3

# ※ **딜을 받아 보는 사람**은 여기 적지 않는다.
#   텔레그램에서 봇을 열고 '시작'(/start) 을 누른 사람 전원에게 간다.
#   누가 등록됐는지: py src/telegram_deliver.py --subscribers

# ── 카톡 채팅방 이름 일부 ─────────────────────────────────────────
# 이모지는 넣지 말 것. 콘솔 인코딩 문제가 생긴다(T1 관측).
KAKAO_ROOM=쿠팡 실시간 핫딜방

# ── 주기 (보통은 건드릴 필요 없다) ────────────────────────────────
# 수집 주기(분). 기본 20.
# CYCLE_MINUTES=20
#
# 토스 대시보드 핫 목록을 몇 주기마다 볼지. 기본 3 (= 약 1시간).
# 대시보드는 20분마다 바뀌지 않는다. 매번 보면 117개짜리 목록을
# 반나절에 다 긁고 그다음부터 0건이 된다.
# TOSS_EVERY_N_CYCLES=3
#
# 이 시간보다 오래된 딜은 링크를 만들지도, 보내지도 않는다(시간).
# 핫딜은 선착순이라 지난 건 이미 품절이다.
# MAX_DEAL_AGE_HOURS=12

# ── 스크린샷 판독 (선택) ──────────────────────────────────────────
# 토스 앱 상품 화면을 봇에 보내면 상품명·판매가·정가·할인율을 읽는다.
# 토스가 웹에서 가격을 통째로 빼 놔서, 딜방에 안 올라온 상품은
# 이것 말고 가격을 얻을 방법이 없다.
#
# 없어도 나머지는 전부 동작한다. 사진을 보냈을 때만 안내문이 나간다.
# 키 발급: https://console.anthropic.com/settings/keys
#
# 비용: 폰 스크린샷 1장에 약 30원(claude-opus-5 기준).
#       더 싸게 하려면 OCR_MODEL=claude-haiku-4-5 로 내릴 수 있으나
#       한글 인식률이 떨어져 가격을 잘못 읽을 위험이 있다.
ANTHROPIC_API_KEY=
# OCR_MODEL=claude-opus-5
